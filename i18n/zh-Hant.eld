;;; zh-Hant.eld --- LispM UI's words in Chinese, Traditional  -*- lisp-data -*-
;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "繁體中文"
 :messages
 (("Cancel" . "取消")
  ("OK" . "好")
  ("Choose a File" . "選擇檔案")
  ("%s:" . "%s：")
  ("TAB goes to the next field · C-c C-c %s · C-c C-k cancels" . "TAB 到下一欄 · C-c C-c %s · C-c C-k 取消")
  ("Choose…" . "選取…")
  ("No picture" . "沒有圖片")
  ("Remove" . "移除")
  ("Picture: " . "圖片：")
  ("Not a picture: %s" . "不是圖片：%s")
  ("%s: fill this in" . "%s：請填寫")
  ("Not a form" . "不是表單")))
