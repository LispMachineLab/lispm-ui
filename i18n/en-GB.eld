;;; en-GB.eld --- LispM UI's words in British English  -*- lisp-data -*-
;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "English (UK)"
 :messages
 (("“%s” was moved to the Trash" . "“%s” was moved to the Wastebasket")
  ("Move to Trash" . "Move to Wastebasket")))
