;;; fr.eld --- LispM UI's words in French  -*- lisp-data -*-
;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "Français"
 :messages
 (("Cancel" . "Annuler")
  ("OK" . "OK")
  ("Choose a File" . "Choisir un fichier")
  ("%s:" . "%s :")
  ("TAB goes to the next field · C-c C-c %s · C-c C-k cancels" . "TAB : champ suivant · C-c C-c %s · C-c C-k annule")
  ("Choose…" . "Choisir…")
  ("No picture" . "Aucune image")
  ("Remove" . "Supprimer")
  ("Picture: " . "Image : ")
  ("Not a picture: %s" . "Pas une image : %s")
  ("%s: fill this in" . "%s : à remplir")
  ("Not a form" . "Pas un formulaire")))
