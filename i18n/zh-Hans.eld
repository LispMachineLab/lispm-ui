;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "简体中文"
 :messages
 (("Cancel" . "取消")
  ("OK" . "好")
  ("Choose a File" . "选取文件")
  ("Desktop" . "桌面")
  ("Home" . "个人")
  ("Documents" . "文稿")
  ("Downloads" . "下载")
  ("Pictures" . "图片")
  ("Today" . "今天")
  ("Yesterday" . "昨天")
  ("%-m/%-d/%y" . "%Y/%-m/%-d")
  ("Open" . "打开")
  ("Choose" . "选取")
  ("Name" . "名称")
  ("Date Modified" . "修改日期")
  ("%s:" . "%s：")
  ("TAB goes to the next field · changes take effect at once · C-c C-c closes" . "TAB 到下一栏 · 更改立即生效 · C-c C-c 关闭")
  ("TAB goes to the next field · C-c C-c %s · C-c C-k cancels" . "TAB 到下一栏 · C-c C-c %s · C-c C-k 取消")
  ("Choose…" . "选取…")
  ("No picture" . "没有图片")
  ("Remove" . "移除")
  ("Choose a Picture" . "选取图片")
  ("Picture: " . "图片：")
  ("Not a picture: %s" . "不是图片：%s")
  ("%s: fill this in" . "%s：请填写")
  ("Not a form" . "不是表单")
  ("Menu: " . "菜单：")))
