;;; zh-Hant.eld --- LispM UI's words in Chinese, Traditional  -*- lisp-data -*-
;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "繁體中文"
 :messages
 (("Cancel" . "取消")
  ("OK" . "好")
  ("Choose a File" . "選擇檔案")
  ("Desktop" . "桌面")
  ("Home" . "個人專屬")
  ("Documents" . "文件")
  ("Downloads" . "下載項目")
  ("Pictures" . "圖片")
  ("Today" . "今天")
  ("Yesterday" . "昨天")
  ("%-m/%-d/%y" . "%Y/%-m/%-d")
  ("Open" . "打開")
  ("Choose" . "選擇")
  ("Name" . "名稱")
  ("Date Modified" . "修改日期")
  ("%s:" . "%s：")
  ("TAB goes to the next field · changes take effect at once · C-c C-c closes" . "TAB 到下一欄 · 變更立即生效 · C-c C-c 關閉")
  ("TAB goes to the next field · C-c C-c %s · C-c C-k cancels" . "TAB 到下一欄 · C-c C-c %s · C-c C-k 取消")
  ("Choose…" . "選取…")
  ("No picture" . "沒有圖片")
  ("Remove" . "移除")
  ("Picture: " . "圖片：")
  ("Not a picture: %s" . "不是圖片：%s")
  ("%s: fill this in" . "%s：請填寫")
  ("Not a form" . "不是表單")
  ("Menu: " . "選單：")))
