;;; ja.eld --- LispM UI's words in Japanese  -*- lisp-data -*-
;; SPDX-License-Identifier: AGPL-3.0-or-later

;; See lispm-ui-i18n.el.  Each entry is (MESSAGE . TRANSLATION), a
;; message said in a context (CONTEXT . MESSAGE), a plural's translation
;; the list of its forms; in the order the code writes them.

(:name "日本語"
 :messages
 (("Cancel" . "キャンセル")
  ("OK" . "OK")
  ("Choose a File" . "ファイルを選択")
  ("Desktop" . "デスクトップ")
  ("Home" . "ホーム")
  ("Documents" . "書類")
  ("Downloads" . "ダウンロード")
  ("Pictures" . "ピクチャ")
  ("Today" . "今日")
  ("Yesterday" . "昨日")
  ("%-m/%-d/%y" . "%Y/%m/%d")
  ("Open" . "開く")
  ("Choose" . "選択")
  ("Name" . "名前")
  ("Date Modified" . "変更日")
  ("%s:" . "%s：")
  ("TAB goes to the next field · changes take effect at once · C-c C-c closes" . "TAB：次の項目 · 変更はすぐに反映 · C-c C-c：閉じる")
  ("TAB goes to the next field · C-c C-c %s · C-c C-k cancels" . "TAB：次の項目 · C-c C-c：%s · C-c C-k：キャンセル")
  ("Choose…" . "選択…")
  ("No picture" . "画像なし")
  ("Remove" . "削除")
  ("Choose a Picture" . "ピクチャを選択")
  ("Picture: " . "画像：")
  ("Not a picture: %s" . "画像ではありません：%s")
  ("%s: fill this in" . "%s：入力してください")
  ("Not a form" . "フォームではありません")
  ("Menu: " . "メニュー：")))
